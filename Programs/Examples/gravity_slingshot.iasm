; Registers: R0=x, R1=y, R2=vx, R3=vy, R7=blitter address, R15=input scratch.
LDI 0 3
LDI 1 39
LDI 2 1
LDI 3 -1

$MAIN:
; Erase last ship pixel before reading input / moving.
BLT 0 1
BLTR 7 0
VSTI 7 0

; Any key press fires the thruster: right and up.
INP 15 0
JINP $THRUST 0
JMP $GRAVITY 0
$THRUST:
ADDI 2 1
SUBI 3 1
JMP $GRAVITY 0

; Main planet's gravity zone: x=16..40 and y=8..40.
$GRAVITY:
CMPLI 0 16
JCMP $MOON_CHECK 0
CMPGI 0 40
JCMP $MOON_CHECK 0
CMPLI 1 8
JCMP $MOON_CHECK 0
CMPGI 1 40
JCMP $MOON_CHECK 0
; Horizontal pull toward the red planet at x=29.
CMPLI 0 29
JCMP $MAIN_X_RIGHT 0
CMPGI 0 29
JCMP $MAIN_X_LEFT 0
JMP $MAIN_Y 0
$MAIN_X_RIGHT:
ADDI 2 1
JMP $MAIN_Y 0
$MAIN_X_LEFT:
SUBI 2 1
$MAIN_Y:
; Vertical pull toward the red planet at y=24.
CMPLI 1 24
JCMP $MAIN_Y_DOWN 0
CMPGI 1 24
JCMP $MAIN_Y_UP 0
JMP $MOON_CHECK 0
$MAIN_Y_DOWN:
ADDI 3 1
JMP $MOON_CHECK 0
$MAIN_Y_UP:
SUBI 3 1

; Blue moon gravity zone: x=38..50 and y=5..20.
$MOON_CHECK:
CMPLI 0 38
JCMP $CLAMP_X 0
CMPGI 0 50
JCMP $CLAMP_X 0
CMPLI 1 5
JCMP $CLAMP_X 0
CMPGI 1 20
JCMP $CLAMP_X 0
; Pull toward the moon at (44,12).
CMPLI 0 44
JCMP $MOON_X_RIGHT 0
CMPGI 0 44
JCMP $MOON_X_LEFT 0
JMP $MOON_Y 0
$MOON_X_RIGHT:
ADDI 2 1
JMP $MOON_Y 0
$MOON_X_LEFT:
SUBI 2 1
$MOON_Y:
CMPLI 1 12
JCMP $MOON_Y_DOWN 0
CMPGI 1 12
JCMP $MOON_Y_UP 0
JMP $CLAMP_X 0
$MOON_Y_DOWN:
ADDI 3 1
JMP $CLAMP_X 0
$MOON_Y_UP:
SUBI 3 1

; Cap both speeds so a single frame cannot skip across the screen.
$CLAMP_X:
CMPGI 2 3
JCMP $VX_MAX 0
CMPLI 2 -3
JCMP $VX_MIN 0
JMP $CLAMP_Y 0
$VX_MAX:
LDI 2 3
JMP $CLAMP_Y 0
$VX_MIN:
LDI 2 -3
$CLAMP_Y:
CMPGI 3 3
JCMP $VY_MAX 0
CMPLI 3 -3
JCMP $VY_MIN 0
JMP $MOVE 0
$VY_MAX:
LDI 3 3
JMP $MOVE 0
$VY_MIN:
LDI 3 -3

$MOVE:
ADD 0 2
ADD 1 3

; Keep coordinates on screen before making any video address.
$BOUNDS:
CMPLI 0 0
JCMP $CRASH 0
CMPGI 0 63
JCMP $CRASH 0
CMPLI 1 0
JCMP $CRASH 0
CMPGI 1 47
JCMP $CRASH 0

; Reaching the beacon wins, but only in its upper-right window.
CMPGI 0 56
JCMP $GOAL_X 0
JMP $RED_COLLISION 0
$GOAL_X:
CMPLI 1 8
JCMP $WIN 0
JMP $RED_COLLISION 0

; Collision box around red planet.
$RED_COLLISION:
CMPLI 0 25
JCMP $MOON_COLLISION 0
CMPGI 0 32
JCMP $MOON_COLLISION 0
CMPLI 1 20
JCMP $MOON_COLLISION 0
CMPGI 1 27
JCMP $MOON_COLLISION 0
JMP $CRASH 0

; Collision box around blue moon.
$MOON_COLLISION:
CMPLI 0 41
JCMP $DRAW_SHIP 0
CMPGI 0 47
JCMP $DRAW_SHIP 0
CMPLI 1 9
JCMP $DRAW_SHIP 0
CMPGI 1 15
JCMP $DRAW_SHIP 0
JMP $CRASH 0

$CRASH:
; Reset after a crash; planets and beacon stay drawn.
LDI 0 3
LDI 1 39
LDI 2 1
LDI 3 -1
JMP $MAIN 0

$DRAW_SHIP:
BLT 0 1
BLTR 7 0
VSTI 7 1
JMP $MAIN 0

$WIN:
BLT 0 1
BLTR 7 0
VSTI 7 3
HALT 0 0
