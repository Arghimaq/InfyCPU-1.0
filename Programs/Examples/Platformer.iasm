
; MINI PLATFORMER
; 64x48 display. Automatic rightward movement; press any key to jump.
; White pixel = player, red triangles = spikes, green row = ground.
; Yellow/cyan flag at the right marks the finish.
; Current input interface detects any key press, not individual key names.

LDI 0 0
LDI 1 44
$GROUND:
BLT 0 1
BLTR 7 0
VSTI 7 4
ADDI 0 1
CMPGI 0 63
JCMP $GROUND 1

; Spike 1
BLTI 12 43
BLTR 7 0
VSTI 7 2
BLTI 13 42
BLTR 7 0
VSTI 7 2
BLTI 14 43
BLTR 7 0
VSTI 7 2

; Spike 2
BLTI 24 43
BLTR 7 0
VSTI 7 2
BLTI 25 42
BLTR 7 0
VSTI 7 2
BLTI 26 43
BLTR 7 0
VSTI 7 2

; Spike 3
BLTI 36 43
BLTR 7 0
VSTI 7 2
BLTI 37 42
BLTR 7 0
VSTI 7 2
BLTI 38 43
BLTR 7 0
VSTI 7 2

; Spike 4
BLTI 48 43
BLTR 7 0
VSTI 7 2
BLTI 49 42
BLTR 7 0
VSTI 7 2
BLTI 50 43
BLTR 7 0
VSTI 7 2

; Finish pole
BLTI 61 38
BLTR 7 0
VSTI 7 5
BLTI 61 39
BLTR 7 0
VSTI 7 5
BLTI 61 40
BLTR 7 0
VSTI 7 5
BLTI 61 41
BLTR 7 0
VSTI 7 5
BLTI 61 42
BLTR 7 0
VSTI 7 5
BLTI 61 43
BLTR 7 0
VSTI 7 5

; Yellow flag
BLTI 58 38
BLTR 7 0
VSTI 7 3
BLTI 59 38
BLTR 7 0
VSTI 7 3
BLTI 60 38
BLTR 7 0
VSTI 7 3

; Player state: x=2, y=42, vx=1, vy=0, grounded=1
LDI 0 2
LDI 1 42
LDI 2 1
LDI 3 0
LDI 4 1

$MAIN:
; Erase previous player pixel
BLT 0 1
BLTR 7 0
VSTI 7 0

; Any newly pressed key can trigger a jump
INP 5 0
JINP $KEY 0
JMP $PHYSICS 0

$KEY:
CMPEI 4 1
JCMP $JUMP 0
JMP $PHYSICS 0

$JUMP:
LDI 3 -5
LDI 4 0
JMP $PHYSICS 0

$PHYSICS:
; Skip gravity while grounded
CMPEI 4 1
JCMP $MOVE 0
ADDI 3 1
ADD 1 3
CMPGI 1 41
JCMP $LAND 0
JMP $MOVE 0

$LAND:
LDI 1 42
LDI 3 0
LDI 4 1

$MOVE:
; Automatic movement to the right
ADD 0 2

; Spike collision checks
CMPEI 0 13
JCMP $HIT13 0
JMP $CHECK25 0
$HIT13:
CMPGI 1 41
JCMP $DEAD 0

$CHECK25:
CMPEI 0 25
JCMP $HIT25 0
JMP $CHECK37 0
$HIT25:
CMPGI 1 41
JCMP $DEAD 0

$CHECK37:
CMPEI 0 37
JCMP $HIT37 0
JMP $CHECK49 0
$HIT37:
CMPGI 1 41
JCMP $DEAD 0

$CHECK49:
CMPEI 0 49
JCMP $HIT49 0
JMP $CHECKGOAL 0
$HIT49:
CMPGI 1 41
JCMP $DEAD 0

$CHECKGOAL:
CMPGI 0 60
JCMP $WIN 0

; Draw player at new position
BLT 0 1
BLTR 7 0
VSTI 7 1
JMP $MAIN 0

$DEAD:
; Restart at the left edge
LDI 0 2
LDI 1 42
LDI 3 0
LDI 4 1
JMP $MAIN 0

$WIN:
; Turn player yellow at the finish
BLT 0 1
BLTR 7 0
VSTI 7 3
HALT 0 0
