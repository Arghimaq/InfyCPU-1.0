$start:
CALL $clear_board 0 ; initialize board memory
STI 0 3
STI 1 0
STI 2 0
STI 3 0
STI 4 0
STI 5 0
STI 6 0
STI 7 0
STI 8 0
STI 21 0
STI 22 0
CALL $clear_side 0
CALL $draw_border 0
CALL $spawn_piece 0
JMP $main 0
$main:
LD 0 21
CMPEI 0 1
JCMP $gameover_loop 0
INP 16 0
JINP $key_dispatch 0
JMP $timer 0
$key_dispatch:
CMPEI 16 left
JCMP $key_left 0
CMPEI 16 right
JCMP $key_right 0
CMPEI 16 down
JCMP $key_down 0
CMPEI 16 up
JCMP $key_rotate 0
CMPEI 16 space
JCMP $key_space 0
JMP $timer 0
$key_left:
LD 0 0
SUBI 0 1
ST 9 0
LD 0 1
ST 10 0
LD 0 3
ST 11 0
CALL $apply_candidate 0
JMP $timer 0
$key_right:
LD 0 0
ADDI 0 1
ST 9 0
LD 0 1
ST 10 0
LD 0 3
ST 11 0
CALL $apply_candidate 0
JMP $timer 0
$key_rotate:
LD 0 0
ST 9 0
LD 0 1
ST 10 0
LD 0 3
ADDI 0 1
CMPEI 0 4
JCMP $rotate_wrap 0
ST 11 0
JMP $rotate_apply 0
$rotate_wrap:
LDI 0 0
ST 11 0
$rotate_apply:
CALL $apply_candidate 0
JMP $timer 0
$key_down:
LD 0 0
ST 9 0
LD 0 1
ADDI 0 1
ST 10 0
LD 0 3
ST 11 0
CALL $apply_candidate 0
LD 0 7
CMPEI 0 1
JCMP $key_down_lock 0
JMP $timer 0
$key_down_lock:
CALL $lock_and_spawn 0
JMP $timer 0
$key_space:
$hard_drop_loop:
LD 0 0
ST 9 0
LD 0 1
ADDI 0 1
ST 10 0
LD 0 3
ST 11 0
CALL $apply_candidate 0
LD 0 7
CMPEI 0 1
JCMP $hard_drop_lock 0
JMP $hard_drop_loop 0
$hard_drop_lock:
CALL $lock_and_spawn 0
JMP $timer 0
$timer:
LD 0 5
ADDI 0 1
ST 5 0
CMPLi 0 220
JCMP $main 0
STI 5 0
LD 0 0
ST 9 0
LD 0 1
ADDI 0 1
ST 10 0
LD 0 3
ST 11 0
CALL $apply_candidate 0
LD 0 7
CMPEI 0 1
JCMP $gravity_lock 0
JMP $main 0
$gravity_lock:
CALL $lock_and_spawn 0
JMP $main 0
$gameover_loop:
INP 16 0
JINP $gameover_key 0
JMP $gameover_loop 0
$gameover_key:
CMPEI 16 space
JCMP $restart 0
JMP $gameover_loop 0
$restart:
CALL $clear_board 0
